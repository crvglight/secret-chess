{
  "name": "xadrez-com-poderes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @xadrez/web --filter @xadrez/server dev",
    "dev:web": "pnpm --filter @xadrez/web dev",
    "dev:server": "pnpm --filter @xadrez/server dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "dev:rede": "pnpm --parallel --filter @xadrez/web --filter @xadrez/server run dev:rede",
    "publicar": "node scripts/publicar.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
